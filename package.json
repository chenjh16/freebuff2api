{
  "name": "freebuff2api",
  "version": "0.1.1",
  "description": "OpenAI-compatible reverse proxy for the Freebuff (freebuff.com) coding API. Zero runtime dependencies.",
  "license": "MIT",
  "author": "chenjh16",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenjh16/freebuff2api.git"
  },
  "homepage": "https://github.com/chenjh16/freebuff2api#readme",
  "bugs": {
    "url": "https://github.com/chenjh16/freebuff2api/issues"
  },
  "keywords": [
    "freebuff",
    "codebuff",
    "openai",
    "openai-compatible",
    "proxy",
    "api",
    "cli",
    "reverse-proxy",
    "ai",
    "free-ai"
  ],
  "private": false,
  "type": "module",
  "bin": {
    "freebuff2api": "./dist/index.js"
  },
  "files": [
    "dist/",
    "app/",
    "src/",
    "docs/",
    "tools/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:cli": "bun --watch src/index.ts",
    "dev:web": "next dev",
    "start": "bun run src/index.ts",
    "start:web": "next start",
    "login": "bun run src/index.ts login",
    "build": "bun build ./src/index.ts --target=node --format=esm --outfile=dist/index.js",
    "build:web": "next build",
    "typecheck": "tsc -b --noEmit",
    "check": "tsc -b --noEmit && bun run build",
    "test": "bun test tests/unit",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e",
    "test:models": "node tools/model-availability.mjs",
    "test:agentic": "node tests/agentic/run.mjs",
    "test:all": "bun run test:unit && bun run test:e2e"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "^19.1.9",
    "react-dom": "^19.1.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.0"
  }
}
