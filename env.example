# Copy to .env (or set via the Freebuff Keys tab / managed env) and fill in.
#
# --- Hosted deployment (open.freebuff.app) ---
# The hosted Next.js app reads the same variables below. Set them in the
# Freebuff deploy environment (Deployments -> env).
#
# In hosted mode AUTH_TOKENS is OPTIONAL: visitors can also sign in on the
# site itself (device-code login) and get a personal sk-fb-* API key bound to
# their own freebuff.com account. Hosted deployments fail closed when API_KEYS
# is unset; provision an explicit high-entropy client key before exposing /v1.
#
# --- Optional in hosted web-login mode ---
# The standalone CLI can serve the default public model allowlist without a
# Freebuff account token. Add one or more Freebuff (freebuff.com) account auth
# tokens, comma-separated, for Freebuff-only models or authenticated fallback.
# These are the tokens your freebuff.com account uses (get one by running
# `freebuff2api login`, or from your freebuff.com browser session).
# IMPORTANT: this is NOT a proxy API key. Setting AUTH_TOKENS to a client key
# makes the upstream API answer 401 "Invalid API key".
AUTH_TOKENS=

# --- Optional ---
# Freebuff backend base URL (default: https://www.codebuff.com)
# UPSTREAM_BASE_URL=https://www.codebuff.com

# Base URL used by `freebuff2api login` (default: https://freebuff.com)
# LOGIN_BASE_URL=https://freebuff.com

# Optional keys clients must present (Authorization: Bearer <key> or x-api-key).
# Hosted deployments fail closed when API_KEYS is unset; set an explicit,
# high-entropy value (or comma-separated values) before exposing /v1.
# API_KEYS=

# Optional stable secret that derives the encryption key for web-login API
# keys (sk-fb-...). When unset it falls back to a hash of AUTH_TOKENS, then to
# a persisted local secret file, and finally to a per-process random value if
# the filesystem is unavailable. Set a fixed value so keys minted by the site
# survive redeploys and multi-instance deployments. Revocation itself remains
# process-local unless a shared state store is added.
# PROXY_SECRET=

# Optional site access gate (hosted web console). When set, visiting the site
# shows a lock screen: visitors must enter one of these tokens (comma-
# separated) to use the console, or open the site with the token in the URL:
#   https://open.freebuff.app/?token=<SITE_ACCESS_TOKEN>
# Once unlocked the browser remembers the token (localStorage) and re-verifies
# it on every visit. When unset the console stays open to everyone. This is
# the "front door" of the site only — the /v1 API surface is still protected
# by API_KEYS.
# SITE_ACCESS_TOKEN=

# Upstream request timeout, e.g. 30s, 15m (default 15m)
# REQUEST_TIMEOUT=15m

# How long an agent run lives before rotation (default 6h)
# ROTATION_INTERVAL=6h

# Optional HTTP(S) proxy for upstream traffic (Bun honors this natively)
# HTTP_PROXY=http://127.0.0.1:7890

# Listen address (default :23333; Freebuff injects PORT in managed workspaces)
# LISTEN_ADDR=:23333

# Maximum accepted chat request body (default 16MB = 16,000,000 bytes)
# MAX_BODY_SIZE=16MB

# Maximum concurrent chat requests (default 32)
# MAX_CONCURRENT_REQUESTS=32

# Anonymous OpenCode-compatible provider. Enabled by default; set false to
# disable it and use the authenticated Freebuff path only. The implementation
# only accepts the fixed opencode.ai host and only routes the explicit model
# allowlist; it never forwards downstream credentials. Prompts and code for
# allowlisted models are sent to OpenCode, so review its terms/privacy before
# deployment.
# PUBLIC_UPSTREAM_ENABLED=true
# PUBLIC_UPSTREAM_BASE_URL=https://opencode.ai/zen/v1
# PUBLIC_UPSTREAM_MODELS=big-pickle,deepseek-v4-flash-free,mimo-v2.5-free,ling-3.0-flash-free,ling-3.0-tiny-free,nemotron-3-ultra-free,north-mini-code-free,laguna-s-2.1-free,longcat-2.0-free
# PUBLIC_UPSTREAM_TIMEOUT=20s
