# Copy to .env (or set via the Freebuff Keys tab / managed env) and fill in.
#
# --- Required ---
# One or more Freebuff (freebuff.com) auth tokens, comma-separated.
# These are the tokens your browser session uses on freebuff.com.
AUTH_TOKENS=

# --- Optional ---
# Freebuff backend base URL (default: https://www.codebuff.com)
# UPSTREAM_BASE_URL=https://www.codebuff.com

# Base URL used by `freebuff2api login` (default: https://freebuff.com)
# LOGIN_BASE_URL=https://freebuff.com

# Optional keys clients must present (Authorization: Bearer <key> or x-api-key).
# Leave empty to allow open access.
# API_KEYS=

# Upstream request timeout, e.g. 30s, 15m (default 15m)
# REQUEST_TIMEOUT=15m

# How long an agent run lives before rotation (default 6h)
# ROTATION_INTERVAL=6h

# Optional HTTP(S) proxy for upstream traffic (Bun honors this natively)
# HTTP_PROXY=http://127.0.0.1:7890

# Listen address (default :23333; Freebuff injects PORT in managed workspaces)
# LISTEN_ADDR=:23333

# Maximum accepted chat request body (default 16MB = 16,000,000 bytes)
# MAX_BODY_SIZE=16MB

# Maximum concurrent chat requests (default 32)
# MAX_CONCURRENT_REQUESTS=32
